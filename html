  <script>
    const state = {
      currentPart: 1,
      
      // Part 1 Animation States
      p1Ignited: false,

      // Part 2 Guided Lab States
      labStep: 1,           // 1: Cool, 2: Smother, 3: Starve, 4: Free Lab
      stepTaskDone: false,
      
      heat: 400,            // Temperature °C
      o2: 21,               // Oxygen %
      fuel: 100,            // Fuel % (Wax level)
      isBurning: true,     // Active flame
      hasBeaker: false,     // Glass jar placed over candle
      beakerVolume: 100,
      isRemovingFuel: false, // Flag for top-down wax burn animation
      particles: []
    };

    function goToPart(partNum) {
      state.currentPart = partNum;

      ['part1', 'part2', 'part3', 'part4'].forEach((p, idx) => {
        const view = document.getElementById(`${p}-view`);
        const navBtn = document.getElementById(`nav-${p}`);

        if (idx + 1 === partNum) {
          view.classList.remove('hidden');
          view.classList.add('flex');
          navBtn.className = 'flex-1 sm:flex-none px-3 py-1.5 rounded-lg transition-all duration-200 bg-amber-500 text-slate-950 font-bold shadow flex items-center justify-center gap-1 shrink-0';
        } else {
          view.classList.add('hidden');
          view.classList.remove('flex');
          navBtn.className = 'flex-1 sm:flex-none px-3 py-1.5 rounded-lg transition-all duration-200 text-slate-300 hover:text-white flex items-center justify-center gap-1 cursor-pointer shrink-0';
        }
      });

      if (partNum === 2) {
        setTimeout(resizeSimCanvas, 50);
      } else if (partNum === 4) {
        renderQuizQuestion();
      }
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    /* PART 1 LOGIC & CANVAS */
    const burnPreviewCanvas = document.getElementById('burnPreviewCanvas');
    const burnPreviewCtx = burnPreviewCanvas.getContext('2d');
    let burnParticles = [];

    function triggerBurnPreview() {
      if (state.p1Ignited) return;
      state.p1Ignited = true;
      
      document.getElementById('p1-badge').innerText = 'Burning in Progress...';
      document.getElementById('btn-burn-action').disabled = true;
      document.getElementById('btn-burn-action').className = 'py-2.5 bg-slate-800 text-slate-500 font-bold rounded-xl text-xs border border-slate-700 flex items-center justify-center gap-1.5 cursor-not-allowed';
      document.getElementById('btn-burn-label').innerText = 'Logs Burning...';
      document.getElementById('burn-hint').classList.add('hidden');

      // Sequence Callouts
      setTimeout(() => { document.getElementById('badge-co2').classList.remove('hidden'); }, 600);
      setTimeout(() => { document.getElementById('badge-heat').classList.remove('hidden'); }, 1200);
      setTimeout(() => { document.getElementById('badge-ash').classList.remove('hidden'); }, 1800);

      // Enable definition reveal button
      setTimeout(() => {
        document.getElementById('p1-badge').innerText = 'Reaction Finished!';
        const defBtn = document.getElementById('btn-reveal-def');
        defBtn.disabled = false;
        defBtn.className = 'py-2.5 bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-400 hover:to-orange-400 text-slate-950 font-bold rounded-xl text-xs shadow transition-transform active:scale-95 flex items-center justify-center gap-1.5 cursor-pointer animate-bounce';
      }, 2500);
    }

    function drawBurnPreviewCanvas() {
      const w = burnPreviewCanvas.width = burnPreviewCanvas.parentElement.clientWidth;
      const h = burnPreviewCanvas.height = burnPreviewCanvas.parentElement.clientHeight;
      burnPreviewCtx.clearRect(0, 0, w, h);

      const centerX = w / 2;
      const centerY = h * 0.72;

      // Ground Base Line
      burnPreviewCtx.strokeStyle = '#334155';
      burnPreviewCtx.lineWidth = 2;
      burnPreviewCtx.beginPath();
      burnPreviewCtx.moveTo(centerX - 120, centerY + 20);
      burnPreviewCtx.lineTo(centerX + 120, centerY + 20);
      burnPreviewCtx.stroke();

      // Draw Wood Logs
      burnPreviewCtx.save();
      burnPreviewCtx.fillStyle = state.p1Ignited ? '#3b1700' : '#78350f';
      
      // Log 1
      burnPreviewCtx.translate(centerX, centerY);
      burnPreviewCtx.rotate(-0.2);
      burnPreviewCtx.fillRect(-50, -8, 100, 16);
      burnPreviewCtx.rotate(0.2);

      // Log 2
      burnPreviewCtx.rotate(0.2);
      burnPreviewCtx.fillRect(-50, -8, 100, 16);
      burnPreviewCtx.restore();

      if (state.p1Ignited) {
        // Ash Pile Base
        burnPreviewCtx.fillStyle = '#64748b';
        burnPreviewCtx.beginPath();
        burnPreviewCtx.ellipse(centerX, centerY + 6, 45, 10, 0, 0, Math.PI * 2);
        burnPreviewCtx.fill();

        // Spawn Flame, CO2 Bubbles, & Flying Ash Flakes
        if (Math.random() < 0.8) {
          const rand = Math.random();
          if (rand < 0.45) {
            // Flame Particle
            burnParticles.push({
              type: 'flame',
              x: centerX + (Math.random() - 0.5) * 40,
              y: centerY - 10,
              vx: (Math.random() - 0.5) * 1.5,
              vy: -Math.random() * 3.5 - 1.5,
              size: Math.random() * 12 + 6,
              life: 1.0
            });
          } else if (rand < 0.75) {
            // CO2 Bubble Particle
            burnParticles.push({
              type: 'co2_bubble',
              x: centerX + (Math.random() - 0.5) * 35,
              y: centerY - 20,
              vx: (Math.random() - 0.5) * 1.8 - 0.5,
              vy: -Math.random() * 2.5 - 1.5,
              size: Math.random() * 10 + 12,
              life: 1.0,
              wobble: Math.random() * Math.PI * 2
            });
          } else {
            // Flying Ash Flake
            burnParticles.push({
              type: 'ash',
              x: centerX + (Math.random() - 0.5) * 45,
              y: centerY - 10,
              vx: (Math.random() - 0.2) * 2.5 + 0.5,
              vy: -Math.random() * 2 - 1,
              size: Math.random() * 4 + 2,
              life: 1.0,
              rot: Math.random() * Math.PI
            });
          }
        }
      }

      // Render Particles
      for (let i = burnParticles.length - 1; i >= 0; i--) {
        const p = burnParticles[i];
        p.x += p.vx;
        p.y += p.vy;
        p.life -= 0.018;

        if (p.life <= 0) {
          burnParticles.splice(i, 1);
          continue;
        }

        burnPreviewCtx.save();
        if (p.type === 'flame') {
          p.size *= 0.95;
          burnPreviewCtx.globalCompositeOperation = 'lighter';
          burnPreviewCtx.fillStyle = `rgba(249, 115, 22, ${p.life})`;
          burnPreviewCtx.beginPath();
          burnPreviewCtx.arc(p.x, p.y, Math.max(0.1, p.size), 0, Math.PI * 2);
          burnPreviewCtx.fill();
        } else if (p.type === 'co2_bubble') {
          // Animated cyan bubble with formal CO₂ label inside
          p.x += Math.sin(p.wobble + p.life * 6) * 1.0;
          burnPreviewCtx.fillStyle = `rgba(6, 182, 212, ${p.life * 0.25})`;
          burnPreviewCtx.strokeStyle = `rgba(34, 211, 238, ${p.life * 0.9})`;
          burnPreviewCtx.lineWidth = 1.5;
          burnPreviewCtx.beginPath();
          burnPreviewCtx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
          burnPreviewCtx.fill();
          burnPreviewCtx.stroke();

          // Text label CO₂ inside bubble
          burnPreviewCtx.fillStyle = `rgba(207, 250, 254, ${p.life})`;
          burnPreviewCtx.font = 'bold 10px Inter';
          burnPreviewCtx.textAlign = 'center';
          burnPreviewCtx.textBaseline = 'middle';
          burnPreviewCtx.fillText('CO₂', p.x, p.y);
        } else if (p.type === 'ash') {
          // Flying Ash Flake
          p.rot += 0.08;
          burnPreviewCtx.fillStyle = `rgba(203, 213, 225, ${p.life * 0.9})`;
          burnPreviewCtx.beginPath();
          burnPreviewCtx.ellipse(p.x, p.y, p.size, p.size * 0.5, p.rot, 0, Math.PI * 2);
          burnPreviewCtx.fill();
        }
        burnPreviewCtx.restore();
      }
    }

    function openDefinitionModal() {
      document.getElementById('modal-definition').classList.remove('hidden');
    }

    function closeDefinitionAndGoToPart2() {
      document.getElementById('modal-definition').classList.add('hidden');
      goToPart(2);
    }


    const canvas = document.getElementById('simCanvas');
    const ctx = canvas.getContext('2d');

    function resizeSimCanvas() {
      if (!canvas.parentElement) return;
      const rect = canvas.parentElement.getBoundingClientRect();
      canvas.width = rect.width;
      canvas.height = rect.height;
    }
    window.addEventListener('resize', () => {
      resizeSimCanvas();
      drawBurnPreviewCanvas();
    });

    class FireParticle {
      constructor(x, y) {
        this.x = x + (Math.random() - 0.5) * 12;
        this.y = y;
        this.vx = (Math.random() - 0.5) * 1.0;
        this.vy = -Math.random() * 3 - 1;
        this.size = Math.random() * 10 + 6;
        this.life = 1.0;
        this.decay = Math.random() * 0.03 + 0.02;
      }
      update() {
        this.x += this.vx;
        this.y += this.vy;
        this.size *= 0.94;
        this.life -= this.decay;
      }
      draw(ctx) {
        ctx.save();
        ctx.globalCompositeOperation = 'lighter';
        let g = ctx.createRadialGradient(this.x, this.y, 0, this.x, this.y, this.size);
        if (this.life > 0.6) {
          g.addColorStop(0, 'rgba(255, 255, 255, ' + this.life + ')');
          g.addColorStop(0.5, 'rgba(245, 158, 11, ' + this.life + ')');
          g.addColorStop(1, 'rgba(239, 68, 68, 0)');
        } else {
          g.addColorStop(0, 'rgba(239, 68, 68, ' + (this.life * 0.6) + ')');
          g.addColorStop(1, 'rgba(50, 50, 50, 0)');
        }
        ctx.fillStyle = g;
        ctx.beginPath();
        ctx.arc(this.x, this.y, Math.max(0.1, this.size), 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
      }
    }

    function mainGameLoop() {
      if (state.currentPart === 1) {
        drawBurnPreviewCanvas();
      } else if (state.currentPart === 2) {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        evaluateCombustionState();
        renderCandleView();
      }
      requestAnimationFrame(mainGameLoop);
    }

    function evaluateCombustionState() {
      // Jar suffocates O2
      if (state.hasBeaker && state.isBurning) {
        state.beakerVolume = Math.max(0, state.beakerVolume - 0.35);
        state.o2 = Math.max(0, Math.min(21, (state.beakerVolume / 100) * 21));
      }

      // Smooth top-down fuel reduction animation
      if (state.isRemovingFuel && state.fuel > 0) {
        state.fuel = Math.max(0, state.fuel - 0.8);
      }

      // Check combustion conditions
      if (state.isBurning) {
        if (state.heat < 300 || state.o2 < 12 || state.fuel <= 0) {
          state.isBurning = false;
          state.isRemovingFuel = false;
          onFireExtinguished();
        }
      }

      updateMetersAndBadges();
    }

    function renderCandleView() {
      const centerX = canvas.width / 2;
      const deskY = canvas.height * 0.80; // Desk surface base line

      // Desk Surface
      ctx.fillStyle = '#1e293b';
      ctx.fillRect(centerX - 140, deskY, 280, 10);
      ctx.strokeStyle = '#334155';
      ctx.lineWidth = 1.5;
      ctx.strokeRect(centerX - 140, deskY, 280, 10);

      // Candle Pillar (Wax burns down from TOP to BOTTOM)
      const maxWaxHeight = 90;
      const currentWaxHeight = (state.fuel / 100) * maxWaxHeight;
      const candleTopY = deskY - currentWaxHeight;

      if (currentWaxHeight > 0) {
        // Wax Pillar
        ctx.fillStyle = '#fef3c7';
        ctx.fillRect(centerX - 18, candleTopY, 36, currentWaxHeight);
        ctx.strokeStyle = '#fde68a';
        ctx.lineWidth = 2;
        ctx.strokeRect(centerX - 18, candleTopY, 36, currentWaxHeight);

        // Candle Wick on TOP of wax
        ctx.strokeStyle = '#475569';
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.moveTo(centerX, candleTopY);
        ctx.lineTo(centerX, candleTopY - 12);
        ctx.stroke();

        // Flame Particles at top of wick
        if (state.isBurning) {
          for (let i = 0; i < 3; i++) {
            state.particles.push(new FireParticle(centerX, candleTopY - 12));
          }
        }
      }

      // Render Flame Particles
      for (let i = state.particles.length - 1; i >= 0; i--) {
        const p = state.particles[i];
        p.update();
        p.draw(ctx);
        if (p.life <= 0) state.particles.splice(i, 1);
      }

      // GLASS JAR: Completely encloses candle down to desk surface!
      if (state.hasBeaker) {
        ctx.save();
        ctx.strokeStyle = 'rgba(34, 211, 238, 0.8)';
        ctx.fillStyle = 'rgba(186, 230, 253, 0.12)';
        ctx.lineWidth = 3.5;

        const jarWidth = 100;
        const jarHeight = maxWaxHeight + 45; // Tall enough to cover full candle + flame
        const jarX = centerX - jarWidth / 2;
        const jarY = deskY - jarHeight;

        // Glass Jar Body touching the desk Y
        ctx.beginPath();
        ctx.roundRect(jarX, jarY, jarWidth, jarHeight, [16, 16, 2, 2]);
        ctx.fill();
        ctx.stroke();

        // Jar Rim Knob at top
        ctx.fillStyle = 'rgba(34, 211, 238, 0.6)';
        ctx.beginPath();
        ctx.arc(centerX, jarY - 4, 10, 0, Math.PI * 2);
        ctx.fill();

        ctx.restore();
      }
    }

    function onFireExtinguished() {
      if (state.stepTaskDone) return;

      if (state.labStep === 1 && state.heat < 300) {
        state.stepTaskDone = true;
        enableStepNextButton('Great! Fire put out by Cooling. Click Next Task!');
      } else if (state.labStep === 2 && state.o2 < 12) {
        state.stepTaskDone = true;
        enableStepNextButton('Awesome! Fire put out by Smothering. Click Next Task!');
      } else if (state.labStep === 3 && state.fuel <= 0) {
        state.stepTaskDone = true;
        enableStepNextButton('Excellent! Fire put out by Starving. Proceed to Free Lab!');
      }
    }

    function enableStepNextButton(msg) {
      const btn = document.getElementById('btn-next-step');
      btn.disabled = false;
      btn.className = 'w-full py-2 bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-400 hover:to-orange-400 text-slate-950 font-bold rounded-xl text-xs shadow transition-transform active:scale-95 flex items-center justify-center gap-1 cursor-pointer animate-bounce';
      btn.innerHTML = `<span>${msg}</span> ➔`;
    }

    function advanceLabStep() {
      state.labStep++;
      state.stepTaskDone = false;

      // Reset flame for next task
      actionIgnite();

      // Update Step UI
      for (let i = 1; i <= 4; i++) {
        const pill = document.getElementById(`step-pill-${i}`);
        if (i === state.labStep) {
          pill.className = 'px-2.5 py-1 rounded-lg bg-amber-500 text-slate-950';
        } else if (i < state.labStep) {
          pill.className = 'px-2.5 py-1 rounded-lg bg-emerald-900/60 text-emerald-300 border border-emerald-500/30';
        } else {
          pill.className = 'px-2.5 py-1 rounded-lg text-slate-400';
        }
      }

      const nextBtn = document.getElementById('btn-next-step');
      nextBtn.disabled = true;
      nextBtn.className = 'w-full py-2 bg-slate-800 text-slate-500 font-bold rounded-xl text-xs border border-slate-700 cursor-not-allowed flex items-center justify-center gap-1';
      nextBtn.innerHTML = '<span>Complete Current Task First</span>';

      const title = document.getElementById('task-step-title');
      const instruction = document.getElementById('task-instruction');
      const observe = document.getElementById('task-observe');

      if (state.labStep === 2) {
        title.innerText = 'Step 2: Smothering (Remove Oxygen)';
        instruction.innerHTML = 'Tap <strong>"🫙 Cover Glass Jar"</strong> to seal off oxygen.';
        observe.innerText = 'Watch the Oxygen gauge drop inside the sealed jar until the flame dies.';
      } else if (state.labStep === 3) {
        title.innerText = 'Step 3: Starving (Remove Fuel)';
        instruction.innerHTML = 'Tap <strong>"✂️ Burn/Remove Fuel"</strong> to burn away the wax fuel.';
        observe.innerText = 'The candle burns down from top to bottom until no fuel remains.';
      } else if (state.labStep === 4) {
        title.innerText = 'Step 4: Free Lab Exploration';
        instruction.innerHTML = '🎉 Explore freely using all tools and sliders!';
        observe.innerText = 'Adjust temperature & oxygen to test combustion limits.';

        document.getElementById('task-badge').innerText = 'Free Lab';
        document.getElementById('task-badge').className = 'text-[10px] bg-emerald-500/20 text-emerald-300 px-2 py-0.5 rounded-full font-bold';
        nextBtn.classList.add('hidden');
      }
    }

    /* Action Handlers */
    function actionIgnite() {
      state.fuel = 100;
      state.heat = 400;
      state.o2 = 21;
      state.hasBeaker = false;
      state.isBurning = true;
      state.isRemovingFuel = false;
      document.getElementById('jar-indicator').classList.add('hidden');
      document.getElementById('slider-heat').value = 400;
      document.getElementById('slider-o2').value = 21;
    }

    function actionSprayWater() {
      state.heat = 25;
      document.getElementById('slider-heat').value = 25;
    }

    function actionToggleBeaker() {
      state.hasBeaker = true;
      state.beakerVolume = 100;
      document.getElementById('jar-indicator').classList.remove('hidden');
    }

    function actionRemoveFuel() {
      state.isRemovingFuel = true; // Triggers animated top-down wax burn
    }

    function onHeatSliderChange(val) {
      state.heat = parseFloat(val);
      if (state.heat >= 300 && state.o2 >= 12 && state.fuel > 0) state.isBurning = true;
    }

    function onO2SliderChange(val) {
      state.o2 = parseFloat(val);
    }

    function updateMetersAndBadges() {
      document.getElementById('val-heat-disp').innerText = Math.round(state.heat) + '°C';
      document.getElementById('val-o2-disp').innerText = state.o2.toFixed(0) + '%';
      document.getElementById('val-fuel-disp').innerText = Math.round(state.fuel) + '%';

      document.getElementById('lbl-slider-heat').innerText = Math.round(state.heat) + '°C';
      document.getElementById('lbl-slider-o2').innerText = state.o2.toFixed(0) + '%';

      document.getElementById('bar-heat').style.width = Math.min(100, (state.heat / 600) * 100) + '%';
      document.getElementById('bar-o2').style.width = Math.min(100, (state.o2 / 40) * 100) + '%';
      document.getElementById('bar-fuel').style.width = state.fuel + '%';

      const badge = document.getElementById('fire-status-badge');
      const dot = document.getElementById('status-dot');
      const text = document.getElementById('status-text');

      if (state.isBurning) {
        badge.className = 'px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-orange-500/20 text-orange-300 border border-orange-500/50 flex items-center gap-1.5 shadow glow-fire';
        dot.className = 'w-2 h-2 rounded-full bg-orange-500 animate-ping';
        text.innerText = 'Flame Active 🔥';
      } else {
        badge.className = 'px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-slate-800 text-slate-400 border border-slate-700 flex items-center gap-1.5 shadow';
        dot.className = 'w-2 h-2 rounded-full bg-slate-500';
        text.innerText = 'Extinguished';
      }
    }

    function showTriangleInfo(type) {
      const title = document.getElementById('triangle-info-title');
      const desc = document.getElementById('triangle-info-desc');

      if (type === 'heat') {
        title.innerText = '🔥 HEAT (Cooling Method)';
        desc.innerText = 'Water cools fire down below ignition temperature.';
      } else if (type === 'oxygen') {
        title.innerText = '💨 OXYGEN (Smothering Method)';
        desc.innerText = 'Covers or fire blankets seal off fire and block oxygen.';
      } else if (type === 'fuel') {
        title.innerText = '🪵 FUEL (Starving Method)';
        desc.innerText = 'Removing trees or shutting off gas valves cuts off fuel supply.';
      }
    }

    /* ======================================================================== */
    /* PART 4: QUIZ SYSTEM LOGIC */
    /* ======================================================================== */
    const quizQuestions = [
      {
        category: 'Chemical Reaction',
        question: 'What happens during a chemical reaction like burning wood?',
        options: [
          'The wood turns into ice without changing.',
          'NEW substances are formed, like Carbon Dioxide (CO₂) and Ash.',
          'The wood stays exactly the same forever.',
          'The wood evaporates into pure water.'
        ],
        answer: 1,
        explanation: 'A chemical reaction creates NEW substances with different properties! In burning, wood combines with oxygen to form CO₂ gas and solid ash.'
      },
      {
        category: 'Fire Triangle',
        question: 'What three elements make up the Fire Triangle?',
        options: [
          'Water, Soil, and Rocks',
          'Nitrogen, Gold, and Plastic',
          'Heat, Oxygen, and Fuel',
          'Ice, Steam, and Smoke'
        ],
        answer: 2,
        explanation: 'Fire requires Heat, Oxygen, and Fuel to burn. If you take away any ONE element, the fire goes out!'
      },
      {
        category: 'Extinguishing Fire',
        question: 'Spraying water on a fire puts it out primarily by taking away which element?',
        options: [
          'Heat (Cooling the fire)',
          'Fuel (Removing the wood)',
          'Oxygen (Smothering)',
          'Gravity'
        ],
        answer: 0,
        explanation: 'Water cools the fire down below its ignition temperature. This method is called Cooling!'
      },
      {
        category: 'Extinguishing Fire',
        question: 'Covering a burning candle with a glass jar starves the flame of which gas?',
        options: [
          'Hydrogen gas',
          'Oxygen gas (Smothering)',
          'Helium gas',
          'Carbon Monoxide'
        ],
        answer: 1,
        explanation: 'The glass jar seals the candle and blocks fresh air. Once all Oxygen inside is used up, the fire suffocates (Smothering)!'
      },
      {
        category: 'Fire Safety',
        question: 'Cutting down trees ahead of a spreading forest fire helps stop the fire by removing what?',
        options: [
          'Heat',
          'Oxygen',
          'Fuel (Starving the fire)',
          'Light'
        ],
        answer: 2,
        explanation: 'Removing flammable trees creates a firebreak that deprives the fire of Fuel. This method is called Starving the fire!'
      }
    ];

    let currentQuizIndex = 0;
    let quizScore = 0;
    let selectedOptionIndex = null;

    function renderQuizQuestion() {
      const q = quizQuestions[currentQuizIndex];
      document.getElementById('quiz-q-num').innerText = `Question ${currentQuizIndex + 1} of ${quizQuestions.length}`;
      document.getElementById('quiz-q-category').innerText = q.category;
      document.getElementById('quiz-q-text').innerText = q.question;
      document.getElementById('quiz-score-badge').innerText = `${quizScore} / ${quizQuestions.length}`;

      const optionsGrid = document.getElementById('quiz-options-grid');
      optionsGrid.innerHTML = '';

      selectedOptionIndex = null;
      document.getElementById('quiz-explanation').classList.add('hidden');

      const nextBtn = document.getElementById('btn-next-quiz-q');
      nextBtn.disabled = true;
      nextBtn.className = 'w-full py-2.5 bg-slate-800 text-slate-500 font-bold rounded-xl text-xs border border-slate-700 cursor-not-allowed flex items-center justify-center gap-1.5';
      nextBtn.innerHTML = '<span>Select an answer above</span>';

      q.options.forEach((optText, idx) => {
        const btn = document.createElement('button');
        btn.className = 'w-full p-3 bg-slate-950 hover:bg-slate-800 text-slate-200 text-xs font-semibold rounded-xl border border-slate-800 hover:border-amber-500/50 text-left transition-all flex items-start gap-2.5 cursor-pointer';
        btn.onclick = () => selectQuizOption(idx);
        btn.id = `quiz-opt-${idx}`;
        
        btn.innerHTML = `
          <span class="w-5 h-5 rounded-full border border-slate-700 bg-slate-900 text-[11px] font-bold flex items-center justify-center shrink-0 text-slate-400" id="quiz-opt-letter-${idx}">
            ${String.fromCharCode(65 + idx)}
          </span>
          <span class="leading-snug">${optText}</span>
        `;
        optionsGrid.appendChild(btn);
      });
    }

    function selectQuizOption(optIdx) {
      if (selectedOptionIndex !== null) return; // Prevent changing after selection
      selectedOptionIndex = optIdx;

      const q = quizQuestions[currentQuizIndex];
      const isCorrect = optIdx === q.answer;

      if (isCorrect) quizScore++;

      document.getElementById('quiz-score-badge').innerText = `${quizScore} / ${quizQuestions.length}`;

      // Style selected button & correct button
      q.options.forEach((_, idx) => {
        const btn = document.getElementById(`quiz-opt-${idx}`);
        const letter = document.getElementById(`quiz-opt-letter-${idx}`);

        if (idx === q.answer) {
          btn.className = 'w-full p-3 bg-emerald-950/80 text-emerald-200 text-xs font-semibold rounded-xl border-2 border-emerald-500 text-left flex items-start gap-2.5 shadow-md';
          letter.className = 'w-5 h-5 rounded-full bg-emerald-500 text-slate-950 font-bold flex items-center justify-center shrink-0 text-[11px]';
          letter.innerText = '✓';
        } else if (idx === optIdx && !isCorrect) {
          btn.className = 'w-full p-3 bg-rose-950/80 text-rose-200 text-xs font-semibold rounded-xl border-2 border-rose-500 text-left flex items-start gap-2.5 shadow-md';
          letter.className = 'w-5 h-5 rounded-full bg-rose-500 text-white font-bold flex items-center justify-center shrink-0 text-[11px]';
          letter.innerText = '✕';
        } else {
          btn.className = 'w-full p-3 bg-slate-950 text-slate-500 text-xs font-semibold rounded-xl border border-slate-800 text-left flex items-start gap-2.5 opacity-50 cursor-not-allowed';
        }
      });

      // Show Explanation Box
      const expBox = document.getElementById('quiz-explanation');
      const expTitle = document.getElementById('quiz-exp-title');
      const expText = document.getElementById('quiz-exp-text');

      expBox.classList.remove('hidden');
      if (isCorrect) {
        expTitle.className = 'font-bold text-emerald-400';
        expTitle.innerText = '🎉 Correct!';
      } else {
        expTitle.className = 'font-bold text-rose-400';
        expTitle.innerText = '❌ Incorrect!';
      }
      expText.innerText = q.explanation;

      // Enable Next Question Button
      const nextBtn = document.getElementById('btn-next-quiz-q');
      nextBtn.disabled = false;
      nextBtn.className = 'w-full py-2.5 bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-400 hover:to-orange-400 text-slate-950 font-bold rounded-xl text-xs shadow transition-transform active:scale-95 flex items-center justify-center gap-1.5 cursor-pointer animate-bounce';
      
      if (currentQuizIndex < quizQuestions.length - 1) {
        nextBtn.innerHTML = '<span>Next Question ➔</span>';
      } else {
        nextBtn.innerHTML = '<span>See Quiz Summary 🏆</span>';
      }
    }

    function nextQuizQuestion() {
      if (currentQuizIndex < quizQuestions.length - 1) {
        currentQuizIndex++;
        renderQuizQuestion();
      } else {
        // Show Final Summary Card
        document.getElementById('quiz-container').classList.add('hidden');
        const summaryCard = document.getElementById('quiz-summary-card');
        summaryCard.classList.remove('hidden');

        document.getElementById('summary-score-text').innerText = `${quizScore} / ${quizQuestions.length}`;
        const msg = document.getElementById('summary-msg');
        if (quizScore === quizQuestions.length) {
          msg.innerText = '🌟 Perfect score! You are a Primary 6 Fire Science Master!';
        } else if (quizScore >= 3) {
          msg.innerText = '👏 Well done! You have a great grasp of combustion science!';
        } else {
          msg.innerText = '👍 Good effort! Review Parts 1-3 to sharpen your knowledge!';
        }
      }
    }

    function resetQuiz() {
      currentQuizIndex = 0;
      quizScore = 0;
      document.getElementById('quiz-summary-card').classList.add('hidden');
      document.getElementById('quiz-container').classList.remove('hidden');
      renderQuizQuestion();
    }

    /* Global Init */
    window.onload = () => {
      resizeSimCanvas();
      requestAnimationFrame(mainGameLoop);
    };
  </script>
</body>
</html>
