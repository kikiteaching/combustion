<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-950 text-slate-100 selection:bg-amber-500 selection:text-slate-950">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Primary Science Lab: Chemical Reactions & Combustion</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <style>
    body {
      font-family: 'Inter', sans-serif;
      touch-action: manipulation;
    }
    .font-display {
      font-family: 'Fredoka', cursive, sans-serif;
    }
    
    input[type=range] {
      -webkit-appearance: none;
      background: transparent;
    }
    input[type=range]::-webkit-slider-thumb {
      -webkit-appearance: none;
      height: 20px;
      width: 20px;
      border-radius: 50%;
      background: #ffffff;
      cursor: pointer;
      box-shadow: 0 0 10px rgba(0,0,0,0.5);
      margin-top: -7px;
    }
    input[type=range]::-webkit-slider-runnable-track {
      width: 100%;
      height: 6px;
      cursor: pointer;
      border-radius: 3px;
    }

    .glow-fire { box-shadow: 0 0 25px rgba(249, 115, 22, 0.4); }

    canvas {
      touch-action: none;
    }

    @keyframes popIn {
      0% { opacity: 0; transform: scale(0.96) translateY(6px); }
      100% { opacity: 1; transform: scale(1) translateY(0); }
    }
    .animate-pop-in {
      animation: popIn 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
  </style>
</head>
<body class="h-full flex flex-col overflow-x-hidden min-h-screen bg-slate-950 text-slate-100">

  <header class="bg-slate-900/90 backdrop-blur border-b border-slate-800 sticky top-0 z-40 px-3 sm:px-6 py-2.5 shrink-0 shadow-lg">
    <div class="max-w-5xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2.5">
      
      <!-- Logo & Title -->
      <div class="flex items-center space-x-2.5 w-full sm:w-auto justify-between sm:justify-start">
        <div class="flex items-center space-x-2.5">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-amber-500 to-orange-500 flex items-center justify-center text-xl shadow-md shadow-orange-500/20">
            🧪
          </div>
          <div>
            <h1 class="font-display text-base sm:text-lg font-bold bg-gradient-to-r from-amber-300 to-orange-400 bg-clip-text text-transparent">
              Primary Science Lab
            </h1>
            <p class="text-[11px] text-slate-400 font-medium">Combustion & Chemical Reactions</p>
          </div>
        </div>
      </div>

      <!-- Step Navigation Buttons -->
      <nav class="flex bg-slate-950 p-1 rounded-xl border border-slate-800 w-full sm:w-auto justify-between text-xs font-semibold overflow-x-auto gap-1">
        <button id="nav-part1" onclick="goToPart(1)" class="flex-1 sm:flex-none px-3 py-1.5 rounded-lg transition-all duration-200 bg-amber-500 text-slate-950 font-bold shadow flex items-center justify-center gap-1 shrink-0">
          <span>1️⃣</span> <span>1. Reaction</span>
        </button>
        <button id="nav-part2" onclick="goToPart(2)" class="flex-1 sm:flex-none px-3 py-1.5 rounded-lg transition-all duration-200 text-slate-300 hover:text-white flex items-center justify-center gap-1 cursor-pointer shrink-0">
          <span>2️⃣</span> <span>2. Lab</span>
        </button>
        <button id="nav-part3" onclick="goToPart(3)" class="flex-1 sm:flex-none px-3 py-1.5 rounded-lg transition-all duration-200 text-slate-300 hover:text-white flex items-center justify-center gap-1 cursor-pointer shrink-0">
          <span>3️⃣</span> <span>3. Triangle</span>
        </button>
        <button id="nav-part4" onclick="goToPart(4)" class="flex-1 sm:flex-none px-3 py-1.5 rounded-lg transition-all duration-200 text-slate-300 hover:text-white flex items-center justify-center gap-1 cursor-pointer shrink-0">
          <span>4️⃣</span> <span>4. Quiz</span>
        </button>
      </nav>

    </div>
  </header>

  <main class="flex-1 max-w-5xl w-full mx-auto p-3 sm:p-5 flex flex-col gap-4">

    <!-- ======================================================================== -->
    <!-- PART 1: WHAT IS A CHEMICAL REACTION? -->
    <!-- ======================================================================== -->
    <section id="part1-view" class="flex-1 flex flex-col gap-4 animate-pop-in">
      
      <!-- Section Header -->
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
        <div>
          <span class="text-[10px] font-bold text-amber-400 uppercase tracking-widest">Part 1 • Observation</span>
          <h2 class="font-display text-xl font-bold text-white">What is a Chemical Reaction?</h2>
          <p class="text-xs text-slate-300 mt-0.5">Ignite the campfire below to watch NEW substances form during burning!</p>
        </div>
        <div id="part1-status-pill" class="text-xs font-bold px-3 py-1 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/30 shrink-0">
          🔥 Tap Campfire to Burn
        </div>
      </div>

      <!-- Main Animation Canvas Card -->
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 flex flex-col gap-3 shadow-xl">
        <div class="flex items-center justify-between border-b border-slate-800 pb-2">
          <div class="flex items-center gap-2">
            <span class="text-xl">🪵</span>
            <h3 class="font-display text-sm font-bold text-amber-300">Observation: Burning Wood</h3>
          </div>
          <span id="p1-badge" class="text-[10px] bg-amber-500/20 text-amber-300 px-2.5 py-0.5 rounded-full border border-amber-500/30 font-semibold">Ready</span>
        </div>

        <!-- Canvas Container -->
        <div class="relative bg-slate-950 rounded-xl h-64 sm:h-80 border border-slate-800/80 overflow-hidden flex items-center justify-center">
          <canvas id="burnPreviewCanvas" class="w-full h-full block cursor-pointer" onclick="triggerBurnPreview()"></canvas>

          <!-- On-Canvas Clear Interactive Labels -->
          <div id="badge-co2" class="hidden absolute top-4 left-4 bg-cyan-950/90 text-cyan-200 text-xs px-3 py-1.5 rounded-xl border border-cyan-500/50 backdrop-blur shadow-lg animate-bounce">
            💨 <strong>New Gas:</strong> Carbon Dioxide (CO<sub>2</sub>) Bubbles
          </div>
          <div id="badge-heat" class="hidden absolute top-4 right-4 bg-orange-950/90 text-orange-200 text-xs px-3 py-1.5 rounded-xl border border-orange-500/50 backdrop-blur shadow-lg">
            ⚡ <strong>Energy Released:</strong> Heat &amp; Light
          </div>
          <div id="badge-ash" class="hidden absolute bottom-4 right-4 bg-slate-900/90 text-slate-200 text-xs px-3 py-1.5 rounded-xl border border-slate-600 backdrop-blur shadow-lg">
            🌪️ <strong>New Solid:</strong> Ash Flakes &amp; Residue
          </div>

          <div id="burn-hint" class="absolute bottom-3 left-1/2 -translate-x-1/2 text-[11px] bg-slate-900/90 text-amber-300 px-3.5 py-1 rounded-full border border-amber-500/30 backdrop-blur pointer-events-none">
            👇 Tap the wood logs to start burning!
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-1">
          <button id="btn-burn-action" onclick="triggerBurnPreview()" class="py-2.5 bg-gradient-to-r from-orange-500 to-amber-500 hover:from-orange-400 hover:to-amber-400 text-slate-950 font-bold rounded-xl text-xs transition-transform active:scale-95 shadow flex items-center justify-center gap-1.5 cursor-pointer">
            <span>🔥</span> <span id="btn-burn-label">Ignite Wood Logs</span>
          </button>

          <button id="btn-reveal-def" onclick="openDefinitionModal()" disabled class="py-2.5 bg-slate-800 text-slate-500 font-bold rounded-xl text-xs border border-slate-700 transition-all flex items-center justify-center gap-1.5 cursor-not-allowed">
            <span>📜</span> <span>See Science Definition</span>
          </button>
        </div>
      </div>

    </section>

    <div id="modal-definition" class="fixed inset-0 bg-slate-950/80 backdrop-blur-md z-50 flex items-center justify-center p-4 hidden">
      <div class="bg-slate-900 border-2 border-amber-500/60 rounded-2xl p-5 sm:p-6 max-w-md w-full shadow-2xl space-y-4 animate-pop-in">
        
        <div class="flex items-center gap-3 border-b border-slate-800 pb-3">
          <div class="w-10 h-10 bg-amber-500/20 text-amber-300 rounded-xl flex items-center justify-center text-xl border border-amber-500/30">
            📜
          </div>
          <div>
            <span class="text-[10px] font-bold text-amber-400 uppercase tracking-widest">Key Takeaway</span>
            <h3 class="font-display text-lg font-bold text-white">What is a Chemical Reaction?</h3>
          </div>
        </div>

        <div class="bg-amber-950/40 border border-amber-500/40 rounded-xl p-4 text-center">
          <p class="text-sm text-amber-100 font-medium leading-relaxed">
            "A chemical reaction changes substances into <span class="text-amber-300 font-bold underline">NEW substances</span>."
          </p>
        </div>

        <div class="bg-slate-950 rounded-xl p-3 border border-slate-800 text-xs text-slate-300 space-y-1.5">
          <div class="font-bold text-amber-400 text-[11px]">💡 What happened to the wood?</div>
          <ul class="list-disc list-inside space-y-1 text-slate-300 text-[11px]">
            <li>Wood combined with oxygen to burn.</li>
            <li><strong>NEW substances made:</strong> Carbon Dioxide (CO<sub>2</sub>) gas and Ash!</li>
            <li>You cannot turn ash back into wood.</li>
          </ul>
        </div>

        <button onclick="closeDefinitionAndGoToPart2()" class="w-full py-3 bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-400 hover:to-orange-400 text-slate-950 font-bold rounded-xl text-xs shadow transition-transform active:scale-95 flex items-center justify-center gap-1.5 cursor-pointer">
          <span>Proceed to Part 2: Combustion Lab ➔</span>
        </button>

      </div>
    </div>


    <!-- ======================================================================== -->
    <!-- PART 2: STEP-BY-STEP & FREE COMBUSTION LAB -->
    <!-- ======================================================================== -->
    <section id="part2-view" class="hidden flex-1 flex-col gap-4 animate-pop-in">
      
      <!-- Experiment Info Banner -->
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 flex flex-col md:flex-row justify-between items-start md:items-center gap-3">
        <div>
          <span class="text-[10px] font-bold text-amber-400 uppercase tracking-widest">Part 2 • Interactive Experiment</span>
          <h2 class="font-display text-lg sm:text-xl font-bold text-white flex items-center gap-1.5">
            <span>🧪</span> Candle Combustion Lab
          </h2>
          <p class="text-xs text-slate-300 mt-0.5">
            Try removing Heat, Oxygen, or Fuel to put out the flame!
          </p>
        </div>

        <!-- Step Tracker Bar -->
        <div class="flex items-center gap-1 bg-slate-950 p-1.5 rounded-xl border border-slate-800 shrink-0 text-[11px] font-bold">
          <span id="step-pill-1" class="px-2.5 py-1 rounded-lg bg-amber-500 text-slate-950">1. Cool</span>
          <span id="step-pill-2" class="px-2.5 py-1 rounded-lg text-slate-400">2. Smother</span>
          <span id="step-pill-3" class="px-2.5 py-1 rounded-lg text-slate-400">3. Starve</span>
          <span id="step-pill-4" class="px-2.5 py-1 rounded-lg text-slate-400">4. Free Lab</span>
        </div>
      </div>

      <!-- Main Lab Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 flex-1">
        
        <!-- Canvas & Live Gauges (7 Cols) -->
        <div class="lg:col-span-7 flex flex-col gap-3">
          
          <!-- Simulation Viewport -->
          <div class="relative bg-slate-950 rounded-2xl border border-slate-800 overflow-hidden shadow-xl min-h-[300px] flex flex-col justify-between">
            
            <div class="absolute top-3 left-3 right-3 z-10 flex justify-between items-center pointer-events-none">
              <span id="fire-status-badge" class="px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-slate-800 text-slate-400 border border-slate-700 flex items-center gap-1.5 shadow">
                <span class="w-2 h-2 rounded-full bg-slate-500" id="status-dot"></span>
                <span id="status-text">No Fire</span>
              </span>

              <div id="jar-indicator" class="hidden px-2.5 py-0.5 bg-cyan-950/90 text-cyan-300 border border-cyan-500/40 text-[11px] rounded-full font-semibold shadow">
                🫙 Glass Jar Sealed
              </div>
            </div>

            <!-- Canvas Surface -->
            <div class="relative w-full h-full flex-1 min-h-[250px]">
              <canvas id="simCanvas" class="w-full h-full block cursor-pointer"></canvas>
            </div>
          </div>

          <!-- Gauges -->
          <div class="grid grid-cols-3 gap-2">
            <div class="bg-slate-900 border border-slate-800 rounded-xl p-2 text-center">
              <div class="text-[10px] text-red-400 font-bold uppercase">🌡️ Heat</div>
              <div class="text-base font-display font-bold text-red-300" id="val-heat-disp">400°C</div>
              <div class="w-full bg-slate-800 h-1.5 rounded-full overflow-hidden mt-1">
                <div id="bar-heat" class="bg-red-500 h-full transition-all duration-150" style="width: 66%"></div>
              </div>
            </div>

            <div class="bg-slate-900 border border-slate-800 rounded-xl p-2 text-center">
              <div class="text-[10px] text-blue-400 font-bold uppercase">💨 Oxygen</div>
              <div class="text-base font-display font-bold text-blue-300" id="val-o2-disp">21%</div>
              <div class="w-full bg-slate-800 h-1.5 rounded-full overflow-hidden mt-1">
                <div id="bar-o2" class="bg-blue-500 h-full transition-all duration-150" style="width: 21%"></div>
              </div>
            </div>

            <div class="bg-slate-900 border border-slate-800 rounded-xl p-2 text-center">
              <div class="text-[10px] text-amber-400 font-bold uppercase">🪵 Fuel</div>
              <div class="text-base font-display font-bold text-amber-300" id="val-fuel-disp">100%</div>
              <div class="w-full bg-slate-800 h-1.5 rounded-full overflow-hidden mt-1">
                <div id="bar-fuel" class="bg-amber-500 h-full transition-all duration-150" style="width: 100%"></div>
              </div>
            </div>
          </div>

        </div>

        <!-- Task & Controls Panel (5 Cols) -->
        <div class="lg:col-span-5 flex flex-col gap-3">
          
          <!-- Guided Step Task Box -->
          <div id="task-card" class="bg-slate-900 border-2 border-amber-500/60 rounded-2xl p-4 space-y-2.5 shadow-lg">
            <div class="flex items-center justify-between border-b border-slate-800 pb-2">
              <span id="task-step-title" class="text-xs font-bold text-amber-400 uppercase tracking-wider">
                Step 1: Cooling (Remove Heat)
              </span>
              <span id="task-badge" class="text-[10px] bg-amber-500/20 text-amber-300 px-2 py-0.5 rounded-full font-bold">
                Active Task
              </span>
            </div>

            <p id="task-instruction" class="text-xs text-slate-200 font-medium leading-relaxed">
              Tap <strong>"💧 Spray Water"</strong> to drop temperature below ignition point.
            </p>

            <div class="bg-slate-950 rounded-xl p-2 border border-slate-800 text-[11px] text-slate-300 space-y-0.5">
              <span class="font-bold text-amber-400 block">👁️ Observation:</span>
              <p id="task-observe" class="text-slate-400 leading-normal">
                Water absorbs heat, putting out fire immediately.
              </p>
            </div>

            <!-- Step Completion / Proceed Button -->
            <button id="btn-next-step" onclick="advanceLabStep()" disabled class="w-full py-2 bg-slate-800 text-slate-500 font-bold rounded-xl text-xs border border-slate-700 transition-all cursor-not-allowed flex items-center justify-center gap-1">
              <span>Complete Current Task First</span>
            </button>
          </div>

          <!-- Tools -->
          <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 space-y-3">
            <h3 class="font-display text-xs font-bold text-amber-300 uppercase tracking-wider border-b border-slate-800 pb-1.5">
              🛠️ Extinguishing Tools
            </h3>

            <div class="grid grid-cols-2 gap-2">
              <button id="tool-btn-ignite" onclick="actionIgnite()" class="py-2.5 bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-400 hover:to-orange-400 text-slate-950 font-bold rounded-xl text-xs shadow active:scale-95 transition-transform flex items-center justify-center gap-1 cursor-pointer">
                <span>🔥</span> Light Candle
              </button>

              <button id="tool-btn-water" onclick="actionSprayWater()" class="py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-bold rounded-xl text-xs shadow active:scale-95 transition-transform flex items-center justify-center gap-1 cursor-pointer">
                <span>💧</span> Spray Water
              </button>

              <button id="tool-btn-jar" onclick="actionToggleBeaker()" class="py-2.5 bg-cyan-700 hover:bg-cyan-600 text-white font-bold rounded-xl text-xs shadow active:scale-95 transition-transform flex items-center justify-center gap-1 cursor-pointer">
                <span>🫙</span> Cover Glass Jar
              </button>

              <button id="tool-btn-fuel" onclick="actionRemoveFuel()" class="py-2.5 bg-amber-700 hover:bg-amber-600 text-white font-bold rounded-xl text-xs shadow active:scale-95 transition-transform flex items-center justify-center gap-1 cursor-pointer">
                <span>✂️</span> Burn/Remove Fuel
              </button>
            </div>

            <!-- Free Lab Adjustments -->
            <div id="sandbox-controls" class="border-t border-slate-800 pt-3 space-y-2">
              <div class="text-[10px] font-bold text-amber-400 uppercase tracking-wider">Free Lab Sliders:</div>
              <div>
                <div class="flex justify-between text-[11px] text-slate-300 mb-1 font-semibold">
                  <span>Temperature</span>
                  <span id="lbl-slider-heat">400°C</span>
                </div>
                <input type="range" id="slider-heat" min="0" max="600" value="400" class="w-full accent-red-500" oninput="onHeatSliderChange(this.value)">
              </div>
              <div>
                <div class="flex justify-between text-[11px] text-slate-300 mb-1 font-semibold">
                  <span>Oxygen Level</span>
                  <span id="lbl-slider-o2">21%</span>
                </div>
                <input type="range" id="slider-o2" min="0" max="40" value="21" class="w-full accent-blue-500" oninput="onO2SliderChange(this.value)">
              </div>
            </div>

          </div>

          <!-- Proceed to Part 3 Button -->
      <button id="btn-to-part3" onclick="goToPart(3)" class="w-full py-2.5 bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-400 hover:to-orange-400 text-slate-950 font-bold rounded-xl text-xs shadow transition-transform active:scale-95 flex items-center justify-center gap-1.5 cursor-pointer">
        <span>Go to Part 3: Fire Triangle ➔</span>
      </button>

    </div>

  </div>

</section>


<!-- ======================================================================== -->
<!-- PART 3: LESSON CONCLUSION & FIRE TRIANGLE -->
<!-- ======================================================================== -->
<section id="part3-view" class="hidden flex-1 flex-col gap-4 animate-pop-in">
  
  <!-- Part 3 Header -->
  <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4">
    <span class="text-[10px] font-bold text-amber-400 uppercase tracking-widest">Part 3 • Lesson Summary</span>
    <h2 class="font-display text-xl font-bold text-white">The Fire Triangle</h2>
    <p class="text-xs text-slate-300 mt-0.5">
      Fire needs 3 things: <strong>Heat</strong>, <strong>Oxygen</strong>, and <strong>Fuel</strong>. Take away any ONE to put out the fire!
    </p>
  </div>

  <!-- Fire Triangle Diagram Card -->
  <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 sm:p-5 shadow-xl flex flex-col items-center gap-3">
    <h3 class="font-display text-base font-bold text-amber-300 text-center">
      🔺 Interactive Fire Triangle
    </h3>
    <p class="text-xs text-slate-400 text-center -mt-1">
      Tap any side to see how firefighters stop fire!
    </p>

    <!-- SVG FIRE TRIANGLE DIAGRAM -->
    <div class="relative w-full max-w-xs aspect-square flex items-center justify-center my-1">
      <svg viewBox="0 0 400 360" class="w-full h-full drop-shadow-xl">
        <!-- Triangle Outline -->
        <polygon points="200,40 50,300 350,300" fill="none" stroke="rgba(245, 158, 11, 0.2)" stroke-width="20" stroke-linejoin="round" />
        
        <!-- Side 1: HEAT (Left) -->
        <g class="cursor-pointer group" onclick="showTriangleInfo('heat')">
          <line x1="200" y1="40" x2="50" y2="300" stroke="#ef4444" stroke-width="14" stroke-linecap="round" class="transition-all hover:stroke-red-400" />
          <circle cx="125" cy="170" r="24" fill="#7f1d1d" stroke="#ef4444" stroke-width="3" />
          <text x="125" y="176" text-anchor="middle" fill="#ffffff" font-size="20">🔥</text>
          <text x="95" y="140" fill="#fca5a5" font-family="Fredoka" font-size="13" font-weight="bold" transform="rotate(-60 95,140)">HEAT</text>
        </g>

        <!-- Side 2: OXYGEN (Right) -->
        <g class="cursor-pointer group" onclick="showTriangleInfo('oxygen')">
          <line x1="200" y1="40" x2="350" y2="300" stroke="#3b82f6" stroke-width="14" stroke-linecap="round" class="transition-all hover:stroke-blue-400" />
          <circle cx="275" cy="170" r="24" fill="#1e3a8a" stroke="#3b82f6" stroke-width="3" />
          <text x="275" y="176" text-anchor="middle" fill="#ffffff" font-size="20">💨</text>
          <text x="295" y="140" fill="#93c5fd" font-family="Fredoka" font-size="13" font-weight="bold" transform="rotate(60 295,140)">OXYGEN</text>
        </g>

        <!-- Side 3: FUEL (Bottom) -->
        <g class="cursor-pointer group" onclick="showTriangleInfo('fuel')">
          <line x1="50" y1="300" x2="350" y2="300" stroke="#f59e0b" stroke-width="14" stroke-linecap="round" class="transition-all hover:stroke-amber-400" />
          <circle cx="200" cy="300" r="24" fill="#78350f" stroke="#f59e0b" stroke-width="3" />
          <text x="200" y="306" text-anchor="middle" fill="#ffffff" font-size="20">🪵</text>
          <text x="200" y="336" text-anchor="middle" fill="#fde68a" font-family="Fredoka" font-size="13" font-weight="bold">FUEL</text>
        </g>

        <!-- Center Flame -->
        <g class="animate-pulse">
          <circle cx="200" cy="190" r="30" fill="rgba(249, 115, 22, 0.2)" />
          <text x="200" y="202" text-anchor="middle" font-size="36">🔥</text>
        </g>
      </svg>
    </div>

    <!-- Explainer Box -->
    <div id="triangle-info-box" class="w-full bg-slate-950 border border-slate-800 rounded-xl p-3.5 text-xs text-slate-200">
      <div id="triangle-info-title" class="font-bold text-amber-300 text-xs mb-1">
        💡 Tap a side of the Fire Triangle above!
      </div>
      <p id="triangle-info-desc" class="text-slate-400 leading-relaxed">
        Select Heat, Oxygen, or Fuel to learn how to extinguish fire.
      </p>
    </div>
  </div>

